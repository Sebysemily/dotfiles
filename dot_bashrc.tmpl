{{ if stat "/usr/share/omarchy" }}
# ==============================================================================
# --- OMARCHY (LAPTOP) ---
# ==============================================================================
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
[[ $- != *i* ]] && return
source "$OMARCHY_PATH/default/bash/rc"

export HISTTIMEFORMAT="%F %T "

alias rm='trash -v'
alias vim='nvim'
alias vi='nvim'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'

kssh() {
  local rc started
  started=$SECONDS
  
  kitty +kitten ssh "$@"
  rc=$?

  [[ -t 1 ]] || return $rc
  _ssh_disarm

  if (( rc != 255 )) || [[ ! -t 0 ]] || ! _ssh_interactive "$@" || (( SECONDS - started < 30 )); then
    return $rc
  fi

  (
    while true; do
      echo "Connection lost. Reconnecting via Kitty (Ctrl-C to stop)..."
      sleep 2
      kitty +kitten ssh "$@"
      rc=$?
      _ssh_disarm
      (( rc != 255 )) && exit $rc
    done
  )
}
alias oreo='kssh sebas@oreo'
alias kindred='kssh sebas@kindred'

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  \rm -f -- "$tmp"
}

set -h
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/sebas/miniforge3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/sebas/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/sebas/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/sebas/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE='/home/sebas/miniforge3/bin/mamba';
export MAMBA_ROOT_PREFIX='/home/sebas/miniforge3';
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<
alias conda='mamba'
set +h

{{ else }}
# ==============================================================================
# --- SERVIDORES (HOMELAB / RAW LINUX) ---
# ==============================================================================

# Cargar configuraciones del sistema si existen
[ -f /etc/bashrc ] && . /etc/bashrc
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
[ -f /etc/bash_completion ] && . /etc/bash_completion

# Configuración del Historial
export HISTFILESIZE=10000
export HISTSIZE=500
export HISTTIMEFORMAT="%F %T "
export HISTCONTROL=erasedups:ignoredups:ignorespace
shopt -s checkwinsize histappend
PROMPT_COMMAND='history -a'

# Variables XDG
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export LINUXTOOLBOXDIR="$HOME/linuxtoolbox"

# Editores y variables globales
export EDITOR=nvim
export VISUAL=nvim
export CLICOLOR=1
export LD_LIBRARY_PATH=$HOME/lib:$LD_LIBRARY_PATH
export PATH=/home/sebas/.opencode/bin:$PATH

# Salir si la terminal no es interactiva (Protege comandos interactivos como bind)
[[ $- != *i* ]] && return

# Quality of Life (Bash & Readline)
bind "set completion-ignore-case on" 2>/dev/null
bind "set show-all-if-ambiguous on" 2>/dev/null
bind "set bell-style none" 2>/dev/null
shopt -s cdspell    # Autocorrige pequeños errores al escribir 'cd'
shopt -s dirspell   # Autocorrige directorios en autocompletado
shopt -s cmdhist    # Guarda comandos de múltiples líneas en un solo historial

# Alias Core (Calidad de vida)
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias vim='nvim'
alias vi='nvim'
alias rm='trash -v'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias oreo='ssh sebas@oreo'
alias kindred='ssh sebas@kindred'
alias kssh="kitty +kitten ssh"

# Inicializar utilidades modernas
if command -v starship &> /dev/null; then eval "$(starship init bash)"; fi
if command -v zoxide &> /dev/null; then eval "$(zoxide init bash)"; fi
if command -v fzf &> /dev/null; then eval "$(fzf --bash)"; fi

# Función para Yazi
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  \rm -f -- "$tmp"
}

# Configuración Mamba/Conda
export MAMBA_EXE='/home/sebas/miniforge3/bin/mamba'
export MAMBA_ROOT_PREFIX='/home/sebas/miniforge3'
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)"
if [ $? -eq 0 ]; then
  eval "$__mamba_setup"
else
  alias mamba="$MAMBA_EXE"
fi
unset __mamba_setup
alias conda='mamba'

{{ end }}
